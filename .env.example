# Supabase project credentials (anon/publishable key only — never the service-role key).
# Find both values in your Supabase dashboard: Project Settings → API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: local-only override of the admin allowlist emails (comma separated).
# In production, keep the allowlist in the database (admin_users table) instead.
# VITE_ADMIN_EMAILS=you@example.com
